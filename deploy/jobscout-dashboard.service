[Unit]
Description=Job Search Copilot Streamlit dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/job-search-copilot
# Bound to LOOPBACK on purpose. This app has no login/auth of its own and the jobs table
# carries your resume-fit history and application status -- the VM's security list only
# allows inbound TCP 22 anyway, so this is belt-and-suspenders, matching how nyse-dashboard
# is deployed on this same box. Reach it with:
#   ssh -i ~/oci-nyse.key -L 8503:127.0.0.1:8503 ubuntu@150.136.41.250
# then open http://localhost:8503 locally.
ExecStart=/home/ubuntu/job-search-copilot/.venv/bin/streamlit run /home/ubuntu/job-search-copilot/app.py \
    --server.port 8503 \
    --server.address 127.0.0.1 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
